{
  "name": "mcp-wechat",
  "version": "1.0.0",
  "description": "独立的微信聊天记录 MCP Server：只读导出文件，经 stdio 或 Streamable HTTP 向任意 MCP 客户端提供聊天数据",
  "type": "module",
  "license": "MIT",
  "private": false,
  "bin": {
    "mcp-wechat": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "smoke": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.2.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
