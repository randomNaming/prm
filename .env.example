# 极简 CRM · 环境变量
# 复制为 .env 后填写。.env 不进版本库。

# MySQL 8.0 连接串（必需）。
# 多环境约定（按需切换，改完重启 dev server 生效）：
#   测试库  mysql://prm_test:<密码>@192.168.31.197:3307/prm_test
#   正式库  mysql://prm_ro:<密码>@<正式库主机>:3306/prm      ← 本地只读，写不进去
#   线上写库 mysql://prm_app:<密码>@<正式库主机>:3306/prm     ← 只在服务器上使用
# 账号与权限见 scripts/sql/provision-roles.sql。
DATABASE_URL=mysql://prm_test:change_me@192.168.31.197:3307/prm_test

# 智谱 GLM Coding Plan 专属接口密钥（可选）。
# 未配置时：智能体对话与后台研究停用，界面明示原因，其余功能正常，进程不崩溃。
# 注意：这是 Coding Plan 专属端点，通用端点密钥不通用。
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZAI_MODEL=glm-5.2

# 访问控制：天权（megrez）单点登录。
# 四项齐全才启用；留空 = 不启用（本地开发不受影响，行为与接入前一致）。
# 回调地址必须与天权后台「接入项目」里登记的值完全一致（协议、端口、路径都算）。
MEGREZ_BASE=http://127.0.0.1:8787
MEGREZ_CLIENT_ID=
MEGREZ_CLIENT_SECRET=
MEGREZ_REDIRECT_URI=http://127.0.0.1:3100/auth/callback

# 部署三阶段：
#   ① 本地（默认）：HOST=127.0.0.1，仅本机可访问
#   ② 内网：HOST=<内网 IP>，仅可信网段
#   ③ 公网：必须前置反向代理并加认证，进入前单独评审
HOST=127.0.0.1
PORT=3000
