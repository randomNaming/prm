# 极简 CRM · 环境变量
# 复制为 .env 后填写。.env 不进版本库。

# MySQL 8.0 连接串（必需）。
# 多环境约定（按需切换，改完重启 dev server 生效）：
#   测试库  mysql://prm_test:<密码>@192.168.31.197:3307/prm_test
#   正式库  mysql://prm_ro:<密码>@<正式库主机>:3306/prm      ← 本地只读，写不进去
#   线上写库 mysql://prm_app:<密码>@<正式库主机>:3306/prm     ← 只在服务器上使用
# 账号与权限见 scripts/sql/provision-roles.sql。
DATABASE_URL=mysql://prm_test:change_me@192.168.31.197:3307/prm_test

# 启动自动迁移（可选，通常只写在服务器的 .env 里）。
# 配置后，应用启动时会把 .output 内置的 server/db/migrations/*.sql 自动补齐；
# 业务读写仍然用上面的 DATABASE_URL（应用账号没有 DDL 权限）。
# 迁移账号建议只给 CREATE / ALTER / INDEX / SELECT，不要给 DELETE / UPDATE / DROP。
# 自动模式只执行「增」的语句；遇到改列、删数据等语句会拒绝启动（见 docs/宝塔部署教程.md）。
# PRM_MIGRATE_URL=mysql://prm_migrate:change_me@127.0.0.1:3308/prm
# 紧急跳过自动迁移（例如数据库维护中）：PRM_AUTO_MIGRATE=off

# 智谱 GLM Coding Plan 专属接口密钥（可选）。
# 未配置时：智能体对话与后台研究停用，界面明示原因，其余功能正常，进程不崩溃。
# 注意：这是 Coding Plan 专属端点，通用端点密钥不通用。
ZAI_API_KEY=
ZAI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
ZAI_MODEL=glm-5.2

# 名片识图：多模态视觉模型（可选，与聊天完全独立，互不影响）。
# 可复用聊天的 key：VISION_API_KEY 填同一个值即可；只换 BASE_URL / MODEL。
# 未配置 key 或 VISION_ENABLED=false 时名片接口返回 503，聊天与研究不受影响。
# 待验证：glm-5.3-flash 是否支持 image_url 图片输入（可跑 bun scripts/vision-smoke.ts 自检）；
# 不支持就换一个支持多模态的模型名，其它配置不动。
VISION_ENABLED=true
VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
VISION_API_KEY=
VISION_MODEL=glm-5.3-flash
VISION_TIMEOUT_MS=45000
VISION_MAX_IMAGE_BYTES=4718592

# 访问控制：天权（megrez）单点登录。
# 四项齐全才启用；留空 = 不启用（本地开发不受影响，行为与接入前一致）。
# 回调地址必须与天权后台「接入项目」里登记的值完全一致（协议、端口、路径都算）。
MEGREZ_BASE=http://127.0.0.1:8787
MEGREZ_CLIENT_ID=
MEGREZ_CLIENT_SECRET=
MEGREZ_REDIRECT_URI=http://127.0.0.1:3100/auth/callback

# 部署三阶段：
#   ① 本地（默认）：HOST=127.0.0.1，仅本机可访问
#   ② 内网：HOST=<内网 IP>，仅可信网段
#   ③ 公网：必须前置反向代理并加认证，进入前单独评审
HOST=127.0.0.1
PORT=3000
