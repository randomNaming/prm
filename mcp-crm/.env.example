# CRM 平台地址（必需）。
# 本服务把聊天记录原文转发到这里，由平台侧智能体抽取联系人与公司并建档。
# 未配置时服务启动即打印中文原因并以非零退出码结束，不会崩溃。
CRM_BASE_URL=http://127.0.0.1:3100

# 单次转发的聊天记录字符上限（可选，默认 50000）。
# 超过该上限时工具会拒绝并提示分批，避免一次塞进过多内容。
CRM_MAX_TEXT_LENGTH=50000

# Streamable HTTP 端口（可选）。留空或删除本行 = 只使用 stdio 模式（默认，推荐）。
# 设置后服务只启动 Streamable HTTP，不再启动 stdio，端点路径为 /mcp。
# 该端口只绑定本机 127.0.0.1。要对公网暴露，必须前置反向代理并配置认证。
MCP_HTTP_PORT=
